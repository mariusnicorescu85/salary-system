# Example secrets.toml file
# Copy this file to secrets.toml and fill in your actual credentials
# NEVER commit secrets.toml to git!

# Authentication Credentials
[credentials]
# Add multiple users here - each user needs:
# - A unique username (the key)
# - A display name
# - A password hash (generate using: python setup_users.py)
usernames = { 
    "admin" = { "name" = "Administrator", "password" = "$2b$12$GENERATE_THIS_USING_SETUP_USERS_PY" },
    "user1" = { "name" = "John Doe", "password" = "$2b$12$GENERATE_THIS_USING_SETUP_USERS_PY" },
    "user2" = { "name" = "Jane Smith", "password" = "$2b$12$GENERATE_THIS_USING_SETUP_USERS_PY" }
}
cookie_name = "salary_calc_cookie"
cookie_key = "GENERATE_A_RANDOM_32_CHARACTER_STRING_HERE"
cookie_expiry_days = 30

# Airtable API Key (for export and optional persistence)
[airtable]
api_key = "your_airtable_api_key_here"

# Optional: persist targets & daily targets to Airtable (for Streamlit Cloud).
# Set persist_targets = true and create 3 tables in your base (see docs).
# persist_base_id = "appXXXXXXXXXXXXXX"   # same base as daily breakdowns, or leave blank to use first shop's base
# persist_targets = true
# shop_targets_table = "Shop Targets"
# daily_targets_table = "Daily Targets"
# monthly_adjustments_table = "Monthly Adjustments"

# --- Email (sending salary breakdowns) ---
# Use one section per shop. Section name must be email_<shop_key> (shop keys: pyt, opatra, silverburn).
# For Gmail: use an App Password (not your normal password). See README / STREAMLIT_CLOUD_SECRETS.md.

[email_pyt]
SMTP_USER = "your-shop-email@gmail.com"
SMTP_PASSWORD = "your_app_password_here"

[email_silverburn]
SMTP_USER = "your-shop-email@gmail.com"
SMTP_PASSWORD = "your_app_password_here"

[email_opatra]
SMTP_USER = "your-shop-email@gmail.com"
SMTP_PASSWORD = "your_app_password_here"
